# ============================================================
#  Spy Phone — environment variables
#  Copy to .env (local) or set in Vercel → Project → Settings →
#  Environment Variables. NEVER commit real values.
# ============================================================

# ── BTCPay Server (Bitcoin payments) ─────────────────────────
# Server-side ONLY. The API key must never appear in client code.
BTCPAY_SERVER_URL=https://btcpay.socialboost.jp
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Public site origin used to build BTCPay redirect URLs.
NEXT_PUBLIC_SITE_URL=https://spyphone.socialboost.jp

# ── Existing: Stripe (card payments) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional base url used by the Stripe checkout (fallback for NEXT_PUBLIC_SITE_URL)
BASE_URL=https://spyphone.socialboost.jp

# ── Existing: Supabase (order persistence) ───────────────────
# The BTCPay webhook accepts either naming pair below.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternate names also supported:
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ── Optional: order notification endpoint (Formspree etc.) ───
ORDER_NOTIFY_ENDPOINT=
